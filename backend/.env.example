# Weather Forecast & Monitoring System - Backend Environment Configuration

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=dev-secret-key-change-this-in-production

# OpenWeatherMap API Integration
# Sign up at https://openweathermap.org/api to get a free API key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Database Configuration (SQLite)
# Points to the local SQLite database file in the database folder
DATABASE_URL=sqlite:///database/weather.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
